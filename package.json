{
  "name": "simplemindmap",
  "productName": "Simple Mindmap",
  "version": "1.5.0",
  "description": "Interactive mindmap editor — collapsible tree, branch colors, Markdown/JSON import-export, PDF output",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node i18n-check.js"
  },
  "author": "Jarvis Qi",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jarvisqi.simplemindmap",
    "files": [
      "index.html",
      "electron/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
